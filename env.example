# This file is safe to commit.
# Do not put real production secrets here.
# Copy to .env and fill real values locally.

# Copy this file before running Docker Compose:
#
#   cp env.example .env
#
# Then edit .env and fill the required values.

# -------------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------------

# Async SQLAlchemy URL used by PackVault (postgresql+asyncpg://...)
PACKVAULT_DATABASE_URL=postgresql+asyncpg://packvault:packvault@postgres:5432/packvault

# -------------------------------------------------------------------
# Required secrets
# -------------------------------------------------------------------

# Required for browser sessions.
# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
PACKVAULT_SESSION_SECRET=

# Required if local auth provider is enabled.
# Generate with:
#   python scripts/hash_password.py <password-string>
PACKVAULT_LOCAL_ADMIN_PASSWORD_HASH=

# Required if Maven/Gradle token auth is configured.
# Generate with:
#   python scripts/hash_token.py <token-string>
PACKVAULT_CI_TOKEN_HASH=
PACKVAULT_READER_TOKEN_HASH=

# -------------------------------------------------------------------
# Local auth
# -------------------------------------------------------------------

PACKVAULT_LOCAL_ADMIN_USERNAME=admin

# -------------------------------------------------------------------
# Maven token names
# -------------------------------------------------------------------

PACKVAULT_CI_TOKEN_NAME=ci-publisher
PACKVAULT_READER_TOKEN_NAME=app-reader

# -------------------------------------------------------------------
# PackVault server
# -------------------------------------------------------------------

PACKVAULT_PUBLIC_URL=http://localhost:8080
PACKVAULT_HOST_PORT=8080
PACKVAULT_OPS_PORT=9090
PACKVAULT_ANONYMOUS_READ=false
PACKVAULT_MAX_UPLOAD_BYTES=524288000
PACKVAULT_REQUEST_TIMEOUT_SECONDS=300

# Config file path inside the container (host ./config is mounted at /config).
PACKVAULT_CONFIG=/config/dev-localstack.yaml

# Lightweight alternative without LocalStack S3 (local disk only):
# PACKVAULT_CONFIG=/config/dev.yaml

# -------------------------------------------------------------------
# Local disk storage (config/dev.yaml)
# -------------------------------------------------------------------

PACKVAULT_LOCAL_ROOT=/data/maven

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------

PACKVAULT_LOG_LEVEL=INFO
PACKVAULT_LOG_FORMAT=json

# -------------------------------------------------------------------
# LocalStack (local AWS emulation: S3 + Secrets Manager)
# -------------------------------------------------------------------
#
# Docker Compose starts LocalStack and runs scripts/localstack-init.sh to create
# the artifact bucket and encryption-key secret before PackVault starts.

LOCALSTACK_HOST_PORT=4566
LOCALSTACK_DEBUG=0

PACKVAULT_AWS_ENDPOINT_URL=http://localstack:4566
PACKVAULT_AWS_REGION=us-east-1
PACKVAULT_AWS_ACCESS_KEY_ID=test
PACKVAULT_AWS_SECRET_ACCESS_KEY=test

PACKVAULT_S3_ENDPOINT_URL=http://localstack:4566
PACKVAULT_S3_BUCKET=packvault
PACKVAULT_S3_PATH_STYLE=true
PACKVAULT_S3_PREFIX=repositories

PACKVAULT_CACHE_PATH=/cache/maven
PACKVAULT_CACHE_METADATA_TTL_SECONDS=60
PACKVAULT_CACHE_SNAPSHOT_TTL_SECONDS=300

# Secret created in LocalStack Secrets Manager by localstack-init (dev-localstack.yaml).
PACKVAULT_SECRETS_MANAGER_SECRET_ID=packvault/dev/encryption-key
# Value seeded into LocalStack; keep stable across restarts or re-run setup after change.
PACKVAULT_SECRETS_ENCRYPTION_KEY=dev-local-encryption-key

# -------------------------------------------------------------------
# Optional Google SSO
# -------------------------------------------------------------------

PACKVAULT_GOOGLE_CLIENT_ID=
PACKVAULT_GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------------
# Optional generic OIDC
# -------------------------------------------------------------------

PACKVAULT_OIDC_CLIENT_ID=
PACKVAULT_OIDC_CLIENT_SECRET=
